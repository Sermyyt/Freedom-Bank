# Optional process environment. No real keys or dataset URLs belong in Git.
LLM_PROVIDER=fake
LLM_MODEL=
LLM_API_KEY=
LLM_BASE_URL=
DATASET_URL=
# Relative DATABASE_PATH is resolved from the working directory (backend/).
DATABASE_PATH=../data/cqa.db
CORS_ORIGINS=http://localhost:3000,http://127.0.0.1:5500
SCORE_ROUNDING=half_up
SCORE_DECIMALS=2
GROSS_ERROR_ZEROES_TOTAL=false
RATIONALE_LANGUAGE=ru
LLM_MAX_CONCURRENCY=2
LLM_TIMEOUT=60
LLM_MAX_ATTEMPTS=3
DATASET_TIMEOUT=60
MAX_UPLOAD_BYTES=20971520
MAX_QUEUED_JOBS=32
